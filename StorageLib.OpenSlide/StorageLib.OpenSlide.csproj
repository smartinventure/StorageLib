<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NuGet package id. Assembly/namespaces remain StorageLib.OpenSlide.* -->
    <PackageId>SmartInVenture.StorageLib.OpenSlide</PackageId>
    <AssemblyName>StorageLib.OpenSlide</AssemblyName>
    <RootNamespace>StorageLib.OpenSlide</RootNamespace>
    <!-- Tracks the StorageLib suite version so it depends on the matching core. -->
    <VersionPrefix>2.2</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
    <Authors>Smart In Venture GmbH</Authors>
    <Company>Smart In Venture GmbH</Company>
    <Product>SmartInVenture Storage Library — OpenSlide</Product>
    <Copyright>Copyright (c) 2025 Smart In Venture GmbH</Copyright>
    <Description>OpenSlide (whole-slide medical imaging) connector and wrapper for SmartInVenture.StorageLib. Split out of the core StorageLib package so the core stays lean; this package bundles the native OpenSlide libraries.</Description>
    <PackageTags>storage;openslide;medical-imaging;whole-slide;deep-zoom;virtual-storage</PackageTags>
    <RepositoryUrl>https://github.com/smartinventure/StorageLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/smartinventure/StorageLib</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StorageLib\StorageLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PooledGrowableBufferHelper" Version="1.0.14" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Native OpenSlide libraries, packed under runtimes\native and copied to consumer output via the .targets below -->
  <ItemGroup>
    <None Update="libs\libcairo-2.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libdicom-1.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libexpat-1.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libffi-8.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libfontconfig-1.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libfreetype-6.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libgdk_pixbuf-2.0-0.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libgio-2.0-0.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libglib-2.0-0.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libgmodule-2.0-0.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libgobject-2.0-0.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libharfbuzz-0.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libjpeg-62.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libopenjp2.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libopenslide-1.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libpixman-1-0.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libpng16-16.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libsharpyuv-0.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libsqlite3-0.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libtiff-6.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libwebp-7.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libxml2-2.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
    <None Update="libs\libz1.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory><PackagePath>runtimes\native</PackagePath><Pack>true</Pack></None>
  </ItemGroup>

  <!-- Auto-imported MSBuild target that copies the native libs to consumer output. Named after the
       package id so NuGet auto-imports it for consumers. -->
  <ItemGroup>
    <None Update="targets\FolderMagic.StorageLib.targets">
      <PackagePath>build\net8.0\SmartInVenture.StorageLib.OpenSlide.targets</PackagePath>
      <Pack>true</Pack>
    </None>
  </ItemGroup>

</Project>
