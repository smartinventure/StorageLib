<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- NuGet Package Metadata -->
    <!-- NuGet package id (globally unique). The assembly name and namespaces remain
         "StorageLib" so consumers keep using `using StorageLib.Abstractions;` etc. -->
    <PackageId>SmartInVenture.StorageLib</PackageId>
    <AssemblyName>StorageLib</AssemblyName>
    <RootNamespace>StorageLib</RootNamespace>
    <!-- 2.0: BREAKING — IStorage.ReadAsync/WriteAsync now return Task<int> (bytes transferred). -->
    <VersionPrefix>2.2</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
    <Authors>Smart In Venture GmbH</Authors>
    <Company>Smart In Venture GmbH</Company>
    <Product>SmartInVenture Storage Library</Product>
    <Copyright>Copyright (c) 2025 Smart In Venture GmbH</Copyright>
    <Description>A comprehensive storage abstraction library providing unified interfaces for local, cloud, and virtual storage systems. Supports file operations, caching, throttling, and extensible storage connectors.</Description>
    <PackageTags>storage;abstraction;file-system;cloud-storage;azure;s3;local-storage;virtual-storage;fuse;openslide;medical-imaging</PackageTags>
    <RepositoryUrl>https://github.com/smartinventure/StorageLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/smartinventure/StorageLib</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Auto-publish to local NuGet feed in Release mode -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Auto-increment build number based on current time -->
    <BuildNumber>$([System.DateTime]::Now.ToString('yyMMdd'))</BuildNumber>
    <RevisionNumber>$([System.DateTime]::Now.ToString('HHmm'))</RevisionNumber>
    <Version>$(VersionPrefix).$(BuildNumber).$(RevisionNumber)</Version>
    <AssemblyVersion>$(VersionPrefix).0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0.0</FileVersion>
  </PropertyGroup>
  
  <!-- Debug version with dev suffix -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Auto-increment build number based on current time for Debug builds -->
    <BuildNumber>$([System.DateTime]::Now.ToString('yyMMdd'))</BuildNumber>
    <RevisionNumber>$([System.DateTime]::Now.ToString('HHmm'))</RevisionNumber>
    <Version>$(VersionPrefix).$(BuildNumber).$(RevisionNumber)-$(VersionSuffix)</Version>
    <AssemblyVersion>$(VersionPrefix).0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0.0</FileVersion>
  </PropertyGroup>

  <!-- Copy NuGet packages to local feed after build (only when the local feed exists,
       e.g. on the developer machine — skipped on CI where D:\NugetFeed is absent). -->
  <Target Name="CopyToLocalFeed" AfterTargets="Pack" Condition="Exists('D:\NugetFeed')">
    <ItemGroup>
      <PackageFiles Include="bin\$(Configuration)\*.nupkg" />
      <PackageFiles Include="bin\$(Configuration)\*.snupkg" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="D:\NugetFeed" />
    <Message Text="Copied $(Configuration) NuGet packages to D:\NugetFeed" Importance="high" />
  </Target>
    
  <!-- Package Release Notes -->
  <PropertyGroup>
    <PackageReleaseNotes>
2.2.0:
- Added production SSH/SFTP and supervised rclone connectors.
- Added EnumStorageType.Rclone and StorageFactory support.

2.1.0:
- OpenSlide moved to a separate package: SmartInVenture.StorageLib.OpenSlide
  (keeps this core package lean; the 11 MB of native imaging libs ship only with
  the OpenSlide package now).
- Core: IStorage abstraction; LocalStorage, MemoryStorage, WindowsMetaMemoryStorage;
  Azure Blob / S3 / SSH connectors; throttling, caching; FuseFlags POSIX support.
- (2.0.0) BREAKING: IStorage.ReadAsync/WriteAsync return Task&lt;int&gt; (bytes transferred).
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Dependencies -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.8" />
    
    <!-- Cloud Storage Dependencies -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.25.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.6.4" />
    
    <!-- Remote Storage Dependencies -->
    <PackageReference Include="SSH.NET" Version="2025.0.0" />
    
    <!-- Performance and Utilities -->
    <PackageReference Include="System.IO.Abstractions" Version="22.0.15" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
